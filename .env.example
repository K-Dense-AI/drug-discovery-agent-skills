# Example environment file for drug-discovery-agent-skills.
#
# Copy to `.env` and fill in only the values you need — every variable here is
# optional in the sense that it gates one specific skill or one repository
# script, and nothing else breaks when it is unset.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real keys. Scripts that read this file use
# python-dotenv (`load_dotenv()`); skills also accept the same names exported in
# your shell.
#
# Most skills in this repository need NO credentials at all: admet-prediction,
# autodock-vina, binding-site-analysis, boltz, chembl, chemical-space,
# clinicaltrials, datamol, deepchem, degraders, depmap, diffdock,
# free-energy-perturbation, generative-design, glycoengineering, immunogenicity,
# medchem, molecular-dynamics, molfeat, ncats-arax, oligonucleotides, openfda,
# open-targets, pkpd-translation, primekg, protein-binder-design, pytdc, rdkit,
# retrosynthesis, target-safety, uniprot-rcsb. They run locally or hit public,
# unauthenticated endpoints.


# =============================================================================
# Skills that require an API key
# =============================================================================

# --- adaptyv -----------------------------------------------------------------
# Adaptyv Bio Foundry cloud lab (protein binding/thermostability assays).
# Get a token from the sidebar at https://foundry.adaptyvbio.com
# Keys look like `abs0_...`. The official curl docs call this FOUNDRY_API_TOKEN;
# it is the same bearer token — this repo standardizes on ADAPTYV_API_KEY.
ADAPTYV_API_KEY=abs0_replace_me

# Optional. Only set to override the default public API base URL.
# ADAPTYV_API_URL=https://foundry-api-public.adaptyvbio.com/api/v1

# Optional. Only needed if your account belongs to multiple organizations.
# ADAPTYV_ORGANIZATION_ID=your_org_id


# --- esm ---------------------------------------------------------------------
# EvolutionaryScale hosted inference (ESM3, ESMC, ESMFold2).
# Create a key at https://biohub.ai/developer-console/api-keys (current Biohub
# platform) or https://forge.evolutionaryscale.ai (legacy Forge-hosted models).
# One key serves both; `esm.sdk.client()` reads it automatically when `token`
# is omitted. Not needed for local model weights run on your own GPU.
ESM_API_KEY=replace_me


# --- rowan -------------------------------------------------------------------
# Rowan computational chemistry cloud (conformers, pKa, descriptors, DFT).
# Create a key from the API-keys section of your Rowan account (rowansci.com).
ROWAN_API_KEY=replace_me


# --- tamarind ----------------------------------------------------------------
# Tamarind Bio managed-GPU platform (AlphaFold, Boltz, RFdiffusion, DiffDock…).
# Create a key under account/API settings at https://app.tamarind.bio
# Sent as the `x-api-key` header. Every account gets 10 free jobs.
TAMARIND_API_KEY=replace_me


# --- patent-landscape ---------------------------------------------------------
# OPTIONAL. The SureChEMBL half of this skill needs no credentials -- it reads the
# public EBI bulk tree. A free PatentsView key adds US assignee and legal-status
# lookup: https://patentsview.org/apis
# Note that without a key PatentsView fails as a connection error, not a 401.
PATENTSVIEW_API_KEY=replace_me

# --- openfda ------------------------------------------------------------------
# OPTIONAL. openFDA works without a key at 1000 requests/day. A free key raises
# that to 120000/day: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=replace_me


# =============================================================================
# Skills with optional configuration (no credentials)
# =============================================================================

# --- primekg -----------------------------------------------------------------
# Absolute path to the PrimeKG edge list (kg.csv, ~1.7 GB) downloaded from
# Harvard Dataverse. Defaults to `data/PrimeKG/kg.csv` relative to the working
# directory when unset.
# PRIMEKG_DATA=/absolute/path/to/PrimeKG/kg.csv


# --- datamol -----------------------------------------------------------------
# Only needed when reading/writing datasets on cloud object storage through
# datamol's fsspec-backed I/O. Standard provider variables; datamol passes them
# straight to fsspec and never transmits them anywhere else. Leave unset for
# purely local files.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Set to 1 to disable datamol's lazy module loading (useful when debugging
# import errors).
# DATAMOL_DISABLE_LAZY_LOADING=1


# =============================================================================
# Repository tooling (maintainers only — not needed to use the skills)
# =============================================================================

# --- scan_skills.py / scan_pr_skills.py --------------------------------------
# LLM key for the Cisco AI Defense skill scanner's LLM analyzer. Must match the
# provider of SKILL_SCANNER_LLM_MODEL below (an Anthropic key for the default
# claude-opus-5). The PR workflow skips the scan entirely when this is unset.
# SKILL_SCANNER_LLM_API_KEY=sk-ant-replace_me

# Optional scanner tuning.
# SKILL_SCANNER_LLM_MODEL=claude-opus-5   # default: claude-opus-5
# SKILL_SCAN_WORKERS=8                    # concurrent skills, default: 8
# SKILL_SCAN_FULL=1                       # force a full rescan, ignoring cache
# SKILL_SCAN_MAX_AGE_DAYS=30              # force a full rescan after N days

# --- tests -------------------------------------------------------------------
# Set to 1 to run the ncats-arax tests that hit the live ARAX endpoint over the
# network. Unset, those tests are skipped.
# ARAX_LIVE_TESTS=1
