.env

# Project
temp/
research/

# Local agent tooling
.claude/
.agents/
# Anchored: an unanchored "scripts/" also matches skills/<name>/scripts/,
# which silently drops every new skill's bundled tooling from git.
/scripts/

skills-lock.json

# uv.lock is deliberately NOT ignored. Every workflow keys its uv cache on it
# and three filter their triggers on it, and without it CI resolves
# cisco-ai-skill-scanner and the git-pinned skills-ref afresh on every run.